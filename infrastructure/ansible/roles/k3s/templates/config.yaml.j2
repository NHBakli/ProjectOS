# Managed by Project OS. Aucune clé ni token n'est écrit ici.
write-kubeconfig-mode: '0600'
secrets-encryption: true
bind-address: {{ k3s_api_bind_address | to_json }}
cluster-cidr: {{ k3s_cluster_cidr | to_json }}
service-cidr: {{ k3s_service_cidr | to_json }}
flannel-backend: {{ k3s_flannel_backend | to_json }}
kube-proxy-arg:
  - {{ ('nodeport-addresses=' ~ k3s_nodeport_addresses) | to_json }}
{% if not k3s_enable_ingress | bool %}
disable:
  - traefik
  - servicelb
{% endif %}
